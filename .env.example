# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finance_tracker

# API Server
PORT=5000

# Plaid (optional — app runs in mock mode without these)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# todo-tracker (optional) -- where recurring items' sync-recurring action sends to-dos.
# `${TODO_API_URL}/todos/by-source/...` must be todo-tracker's own route: the gateway's
# /todo prefix in production (https://<gateway>/todo), or http://localhost:4000 locally.
# Unset = the to-do step of the action reports itself skipped; everything else still runs.
TODO_API_URL=
